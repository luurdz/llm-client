# Provider: openai | anthropic | gemini
LLM_PROVIDER=gemini
# Model: gpt-4o-mini | gemini-flash-lite-latest | claude-opus-5-5
LLM_MODEL=gemini-flash-lite-latest
# Optional (unit 2): model of the same provider used when the main model fails
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=